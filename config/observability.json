{
  "schemaVersion": 1,
  "service": "torudake-reel",
  "production": {
    "provider": "cloudflare-pages-functions",
    "structuredLogs": true,
    "requestHeader": "X-Request-Id",
    "correlationHeader": "X-Correlation-Id",
    "durableAuthentication": {
      "binding": "AUTH_OBSERVABILITY",
      "dataset": "torudake_line_auth_events",
      "retention": "three_months",
      "sampling": 1,
      "forbiddenFields": [
        "code",
        "authorization_code",
        "access_token",
        "id_token",
        "state",
        "nonce",
        "provider_subject",
        "subject_hash",
        "email",
        "cookie",
        "ip_address",
        "user_agent",
        "cf_ray"
      ]
    },
    "sampling": {
      "errors": 1,
      "warnings": 1,
      "success": 1
    },
    "alerts": {
      "syntheticReadinessMinutes": 5,
      "consecutiveReadinessFailures": 2,
      "serverErrorWindowMinutes": 5,
      "serverErrorThreshold": 3,
      "stripeWebhookFailureThreshold": 1
    }
  },
  "workerMaintenance": {
    "config": "wrangler.d1.jsonc",
    "logs": {
      "enabled": true,
      "headSamplingRate": 1
    },
    "traces": {
      "enabled": false,
      "reason": "Traces are intentionally off until the paid observability budget is approved."
    }
  }
}

