{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:cloudflare-pages": "vinext build && node scripts/prepare-cloudflare-pages.mjs && vite build --config cloudflare-pages.vite.config.mjs",
    "start": "vinext start",
    "test": "vinext build && node --experimental-loader=./tests/cloudflare-loader.mjs --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work",
    "db:generate": "drizzle-kit generate",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:preflight:offline": "node scripts/release-preflight.mjs --offline",
    "release:pages": "node scripts/operations/deploy-pages-release.mjs",
    "ops:health": "node scripts/operations/synthetic-readiness.mjs",
    "ops:health:detailed": "node scripts/operations/synthetic-readiness.mjs --detailed",
    "ops:account-deletions": "node scripts/operations/account-deletions.mjs",
    "ops:dry-run-account-deletion-scheduler": "wrangler deploy --config wrangler.account-deletion-scheduler.jsonc --dry-run",
    "ops:deploy-account-deletion-scheduler": "node scripts/operations/deploy-account-deletion-scheduler.mjs",
    "ops:payment-smoke": "node scripts/operations/payment-smoke.mjs",
    "ops:pages-auth-flags": "node scripts/operations/pages-auth-flags.mjs",
    "ops:cloudflare-alerts": "node scripts/operations/configure-cloudflare-alerts.mjs",
    "ops:prepare-character-voice-evaluation": "node scripts/operations/character-voice-evaluation.mjs",
    "ops:prepare-pop-voice-blind-pack": "node scripts/operations/prepare-pop-voice-blind-pack.mjs",
    "ops:generate-character-voice-screening": "node scripts/operations/generate-character-voice-screening.mjs"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "1.51.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "drizzle-orm": "0.45.2",
    "mediabunny": "^1.51.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.118.0",
    "ws": "8.21.1"
  },
  "type": "module"
}
