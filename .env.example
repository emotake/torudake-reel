OPENAI_API_KEY=
# Optional official social profiles. Only valid HTTPS Instagram / YouTube URLs
# are rendered in the footer and Organization structured data.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# At least 32 random characters. Used only by authenticated operations probes.
OPS_HEALTH_SECRET=
ACCOUNT_DELETION_OPERATIONS_SECRET=
# Optional emergency rollback: set to legacy to use gpt-4o-mini-tts.
NARRATION_SPEECH_MODE=realtime
# Selected character profile. Set classic only for an explicit voice rollback.
NARRATION_VOICE_PROFILE=character-v1
# Set to true only on an OpenAI Sites deployment behind its auth dispatcher.
# Leave unset/false on public Cloudflare Pages and Workers deployments.
TRUST_SITES_AUTH_HEADERS=false
PUBLIC_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required for new subscriptions. Checkout stays disabled unless both prices
# exactly match ¥500/month and ¥1,000/month in JPY.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STANDARD_MONTHLY=
# Optional legacy compatibility only: the former ¥1,480/month price ID. Keep
# it configured while any existing subscriber still uses that price.
STRIPE_PRICE_LIGHT_MONTHLY=
STRIPE_PRICE_ONE_TIME=

# Optional operator-only notification after a verified paid Stripe event.
# Keep disabled until a LINE Official Account Messaging API channel, channel
# access token, and operator user/group/room ID have been configured.
LINE_PAYMENT_NOTIFICATION_ENABLED=false
LINE_PAYMENT_NOTIFICATION_ACCESS_TOKEN=
LINE_PAYMENT_NOTIFICATION_TO=
OPERATOR_ENROLLMENT_CODE=
# At least 32 random characters. Keep this value server-side only.
TRIAL_ISSUANCE_SECRET=

# Keep Passkey disabled until the final custom domain (WebAuthn RP ID) is fixed.
# Enable it only after D1 migrations and TRIAL_ISSUANCE_SECRET are ready.
PASSKEY_AUTH_ENABLED=false

# LINE passwordless account authentication. Keep disabled until the LINE Login
# channel, exact callback URL, canonical origin, and secrets are set.
OIDC_AUTH_ENABLED=false
OIDC_CANONICAL_ORIGIN=
# At least 32 random characters. Keep this and LINE_LOGIN_CHANNEL_ID stable:
# changing either breaks stored LINE subject hashes unless the existing
# identities are migrated first.
OIDC_AUTH_SECRET=
LINE_LOGIN_ENABLED=false
# This is also an input to the stored LINE identity hash. Do not rotate it
# without migrating existing account_external_identities rows first.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Controlled rollback only. Google is not shown in the public login UI.
GOOGLE_OIDC_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
